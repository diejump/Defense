     return scores / repeats
+
+
+def sample_at_ratio(data, drop_ratio, restore_axis=0):
+    from torch.distributions import Bernoulli
+    edges, weights = data["edges"], data["weights"]
+    keep = Bernoulli(1 - drop_ratio).sample(weights.size()).bool()
+    sampled = edges[:, keep]
+    sampled_weights = weights[keep]
+    degree = torch.zeros(data["x"].size(0), device=edges.device)
+    degree.index_add_(0, sampled[restore_axis], torch.ones(sampled.size(1), device=edges.device))
+    restore = degree[edges[restore_axis]] == 0
+    return torch.cat([sampled, edges[:, restore]], dim=1), torch.cat([sampled_weights, weights.new_ones(int(restore.sum()))])
+
+
+def sample_paired(data, drop_ratio):
+    # 无向配对作为独立变体，丢弃和孤立恢复都以整条无向连接为单位。
+    edges, weights = data["edges"], data["weights"]
+    count = data["x"].size(0)
+    lower = torch.minimum(edges[0], edges[1])
+    upper = torch.maximum(edges[0], edges[1])
+    keys, inverse = torch.unique(lower * count + upper, return_inverse=True)
+    choices = torch.rand(keys.numel(), device=edges.device) >= drop_ratio
+    keep = choices[inverse]
+    degree = torch.bincount(edges[1, keep], minlength=count)
+    restore = (degree[edges[0]] == 0) | (degree[edges[1]] == 0)
+    choices[inverse[restore]] = True
+    keep = choices[inverse]
+    return edges[:, keep], weights[keep]
+
+
